# Copy to .env to change these. Only needed for a deployed build or a backend on another port.

# Address of the backend API in a deployed build (Vercel: set this in Project > Settings > Environment Variables).
# VITE_API_BASE=https://upi-safety-check-api.onrender.com/api

# Where `npm run dev` forwards /api requests.
# API_TARGET=http://127.0.0.1:8010
